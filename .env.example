# Docker Compose 从仓库根目录的 .env 读取这些变量。
# 复制为 .env 后，必填项建议分别使用 openssl rand -hex 24 生成。
# 密码含 $、# 或空格时用单引号包裹，避免 Compose 插值。
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# 首次初始化时设置 admin 的登录密码；已有数据卷不会自动重置密码。
ADMIN_PASSWORD=

# 基础部署仅绑定服务器回环地址，公网通过 Caddy 的 80/443 访问。
FRONTEND_PORT=8088
METRIX_IMAGE_TAG=local

# 公网 HTTPS 部署必填：仅填写单个域名，不含协议、路径或端口。
METRIX_DOMAIN=
ACME_EMAIL=

# 邮箱注册和重置密码需要 SMTP 配置。
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
AUTH_MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
# 465 端口通常需要 SSL=true、STARTTLS=false，按邮件服务商说明设置。
MAIL_SMTP_SSL_ENABLE=false
AUTH_CAPTCHA_ENABLED=true

# 限额包含 Java 和 Python 子进程；按并发需求调整。
APP_MEMORY_LIMIT=2g
JAVA_TOOL_OPTIONS='-XX:MaxRAMPercentage=70.0 -Djava.awt.headless=true'
