# Metrix 后端环境变量示例
#
# 使用方式：复制为 backend/.env 后按实际环境填写。
# Spring Boot 会通过 application.yml 自动加载该文件；不要将 backend/.env 提交到版本库。
# 未设置的变量会使用 application.yml 中的默认值。生产环境请替换所有示例密码。

# ==================== PostgreSQL（必填） ====================
# JDBC 连接地址、数据库用户名和密码。
POSTGRES_URL=jdbc:postgresql://127.0.0.1:5432/stock_analysis
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=replace_with_a_secure_password

# ==================== Redis（必填） ====================
# Redis 用于登录会话、图形验证码及邮箱验证码缓存。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# 无密码的本地 Redis 可留空。
REDIS_PASSWORD=

# ==================== 邮件验证码 SMTP（生产必填） ====================
# 普通用户注册和忘记密码会通过 SMTP 发送邮箱验证码。
# 本地只调试界面且不触发发送邮件时，可暂不填写；实际注册/重置密码流程需要完整配置。
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=replace_with_smtp_password
# SMTP 认证与 STARTTLS 是否开启。常见的 587 端口配置为 true。
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
# 邮件“发件人”地址；通常应与 MAIL_USERNAME 一致或为已验证的发件人。
AUTH_MAIL_FROM=no-reply@example.com

# ==================== 认证与图形验证码 ====================
# 是否校验全部图形验证码（管理员登录、普通用户登录、发送邮箱验证码）。
# 生产环境必须保持 true；本地联调可设为 false，跳过前端展示与后端校验。
AUTH_CAPTCHA_ENABLED=true

# ==================== 市场数据脚本（可选） ====================
# 仅在脚本路径或超时时间与默认值不同的时候设置。
# TICKFLOW_KLINES_SCRIPT_PATH=python-service/tickflow_klines.py
# BAOSTOCK_MARKET_TURNOVER_SCRIPT_PATH=python-service/baostock_market_turnover.py
# TICKFLOW_TIMEOUT_SECONDS=60
